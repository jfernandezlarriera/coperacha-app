# Template for .env. Copy with: cp env.example .env   (never commit .env)
# Note: this file is meant to live as `.env.example`; the agent session that created it
# could not write dot-env paths, so rename it: mv env.example .env.example

# --- App ---
# Port for the HTTP server.
PORT=3000
# Public base URL used to build shareable links (https://coperacha.app in production).
APP_BASE_URL=http://localhost:3000
# Random string (32+ chars) used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me
# "true" sets the Secure flag on cookies (requires HTTPS). Use "false" for local http.
COOKIE_SECURE=false
# Path of the data file (JSON store). Use ":memory:" for an ephemeral store.
DATABASE_PATH=./data/coperacha.json
# Timezone for deadlines shown to users. Keep America/Mexico_City.
APP_TIMEZONE=America/Mexico_City

# --- Google Sign-In (organizers only) ---
# OAuth 2.0 client from Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# "true" enables POST /auth/dev (sign in with any name/email, no Google). Local use only.
AUTH_DEV_LOGIN=true

# --- Arturito (WhatsApp bot; this app is a client) ---
# Bot phone in international digits without "+" (e.g. 5215512345678). Used for wa.me links.
ARTURITO_PHONE=
# Outbound send endpoint. POST {chatId, type:"text", text} with Authorization: Bearer ARTURITO_SEND_KEY.
ARTURITO_SEND_URL=
ARTURITO_SEND_KEY=
# Registry endpoint: tells Arturito which numbers route to this app. Optional; if empty the app logs and continues.
ARTURITO_REGISTER_URL=
# Token for the registry endpoint. Falls back to ARTURITO_SEND_KEY when empty.
ARTURITO_REGISTER_TOKEN=
# Bearer token Arturito must send on POST /webhooks/arturito. Generate: openssl rand -hex 32
ARTURITO_WEBHOOK_TOKEN=
# Outbound cap shared with Arturito (messages per minute). Keep at 6.
ARTURITO_SEND_LIMIT_PER_MINUTE=6

# --- Pey (CoDi charges) ---
# "mock" (default) never touches the network. "http" uses PEY_API_URL.
PEY_MODE=mock
PEY_API_URL=
PEY_API_KEY=
# Secret used to verify POST /webhooks/pey (HMAC-SHA256 signature or Bearer token).
PEY_WEBHOOK_SECRET=
